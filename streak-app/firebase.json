{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      ".git/**",
      "**/node_modules/**",
      "dist/**",
      "main.js",
      "package.json",
      "package-lock.json",
      "*.md",
      "assetlinks.template.json",
      "preload.js",
      "widget.html"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}